.ld read_all r0
call r0
hlt


;; void read_all(u32 first_sector, u32 count, u32 memory_addr)
read_all::
push r0
push r1
push r2
push r3

.ld h7FE00010 r0

wr32 r0 a0

.ld 0 r2
mv a3 r3

real_all.loop:
.ld h7FE00015 r0

rd8 r0 r1

wr8 r3 r1

addi r2 1 r2
addi r3 1 r3

.ld read_all.loop r0

.if r2 <u a1 r0 pc

pop r3
pop r2
pop r1
pop r0

ret
