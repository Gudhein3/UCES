ldlx 1 r1
ldlx 1 r2

fib_loop:
  push r1
  push r2
  mv r1 a0
  .ld putd r0
  call r0
  pop r2
  pop r1

  mv r1 r3
  add r1 r2 r1
  mv r3 r2

  ldhx #h7FE0 r4
  ldlx 10 r5
  wr8 r4 r5

  ldlx 100 r3
  cmp r1 r3 r3
  tsbi r3 7 r3
  .ld fib_loop r4
  mvo r3 r4 pc

.ld string a0
.ld string_end - string a1
.ld puts t0
call t0

.inc zeros.ubc

.ld putd r0
prel label - . a0
call r0

ldhx #h7FE0 r4
ldlx 10 r5
wr8 r4 r5

.ld label a0
call r0

label:

ldhx #h7FE0 r4
ldlx 10 r5
wr8 r4 r5

.ld putd t0
idiv zero zero a0
call t0

hlt

.inc std.ubc

string:
  .str Hello, world!\n
string_end:
