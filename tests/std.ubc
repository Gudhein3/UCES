
putd::
  .ld 100000 r0

  rem a0 r0 r0

  push a0

  push r0 ;; 1st digit (highest)
  ldlx 10000 r1
  div r0 r1 a0
  .ld putdd1 r0
  call r0
  pop r0

  push r0 ;; 2nd digit (highest)
  ldlx 1000 r1
  div r0 r1 a0
  .ld putdd1 r0
  call r0
  pop r0

  push r0 ;; 3rd digit
  ldlx 100 r1
  div r0 r1 a0
  .ld putdd1 r0
  call r0
  pop r0

  push r0 ;; 4th digit
  ldlx 10 r1
  div r0 r1 a0
  .ld putdd1 r0
  call r0
  pop r0

  push r0 ;; 5th digit (lowest)
  mv r0 a0
  .ld putdd r0
  call r0
  pop r0

  pop a0
  ret

putdd1:
  .ld putdd r0
  mve a0 r0 pc
  ret

putdd:
  ldlx 10 r0
  rem a0 r0 r3

  ldhx #h7FE0 r0

  ldlx 10 r1

  ;; 0-9
  addi r3 #h30 r1
  wr8 r0 r1
  ret

puts::
  push a0
  push a1
puts@start:
  .ld puts@end t0
  mvo a1 t0 pc
  ldhx #h7FE0 t0
  rd8 a0 t1
  wr8 t0 t1
  addi a0 1 a0
  addi a1 -1 & 255 a1
  .ld puts@start t0
  mv t0 pc
puts@end:
  pop a1
  pop a0
  ret