; If you cannot understand something, please consider reading FAQ.txt

ldlx h41 r1 ; Loads value h41 to a register "r1"

; Label
loop:

ldhx h7FE0 r3 ;; Loads value h7FE00000(UART) to a register "r3"

; Note:
;; Operations ldlx and ldhx are rewriting the full register.
;; If you want to write only to the lowest 16 bits or the highest 16 bits, use ldl and ldh respectively:
;;; ldh hBADC r1
;;; ldl h00FE r1

wr8 r3 r1 ;; Writes lower 8 bits from register r1 to memory by address from register r3

addi r1 1 r1 ;; There is an opcode to add immediate 8 bit.

ldlx h5B r2
cmp r2 r1 r2 ;; Compares r1 and r2
tsbi r2 2 r2 ;; Checks that 2 bit(equality flag of "cmp" instruction) is set.

; Write 32 bit immediate to a register
.ld loop r3

mvo r2 r3 pc ;; Moves value from r3 to pc only if value in r2 == 0

ldhx h7FE0 r3
ldlx h0A r2
wr8 r3 r2
hlt
