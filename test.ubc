loop:
  push r0
  mv r0 a0
  ldlx putd r1
  call r1
  pop r0
  addi r0 1 r0

  ldhx h7FE0 r1
  ldlx 10 r2
  wr8 r1 r2

  ldlx loop pc

putd::
  ldl h86A0 r0 ;; 100000
  ldh h0001 r0

  rem a0 r0 r0

  push a0

  push r0 ;; 1st digit (highest)
  ldlx 10000 r1
  div r0 r1 a0
  ldlx putdd1 r0
  call r0
  pop r0

  push r0 ;; 2nd digit (highest)
  ldlx 1000 r1
  div r0 r1 a0
  ldlx putdd1 r0
  call r0
  pop r0

  push r0 ;; 3rd digit
  ldlx 100 r1
  div r0 r1 a0
  ldlx putdd1 r0
  call r0
  pop r0

  push r0 ;; 4th digit
  ldlx 10 r1
  div r0 r1 a0
  ldlx putdd1 r0
  call r0
  pop r0

  push r0 ;; 5th digit (lowest)
  mv r0 a0
  ldlx putdd r0
  call r0
  pop r0

  pop a0
  ret

putdd1:
  ldlx putdd r0
  mve a0 r0 pc
  ret

putdd:
  ldlx 10 r0
  rem a0 r0 r3

  ldhx h7FE0 r0

  ldlx 10 r1

  ;; 0-9
  addi r3 h30 r1
  wr8 r0 r1
  ret
